# Required to post quotations to the normal Telegram destination.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional separate destination for recent-death notifications.
RECENT_DEATH_TELEGRAM_CHAT_ID=

# Optional contact information appended to the Wikimedia User-Agent.
# Use a project contact address or URL, never a private credential.
WIKIMEDIA_USER_AGENT_CONTACT=

# Optional local path to the private authoritative data-repository checkout.
# The default is ../wiki-philosopher-bot-data relative to this source checkout.
PRIVATE_DATA_REPOSITORY_FOLDER=
